DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
REDIS_URL="rediss://default:PASSWORD@HOST:PORT"
JWT_SECRET="change-me"
LOG_LEVEL="debug"
PORT=5000
ENABLE_ANALYTICS_QUEUE=false
ENABLE_REDIS=false
# Despite the XAI_ prefix, this is a Groq API key (console.groq.com) — the
# client hits Groq's OpenAI-compatible endpoint, not xAI's. Naming is a
# known leftover from an earlier provider switch.
XAI_API_KEY="your-groq-api-key"
XAI_MODEL="openai/gpt-oss-120b"
